---
import { site } from "../content/site";

const { author } = site;
const year = new Date().getFullYear();

// Brand profiles (site.sameAs) first, then the author's own; de-duplicated so
// the same account listed in both places renders once. Labels come from the
// host, so adding a URL in site.ts is all it takes.
const LABELS: Record<string, string> = {
  "x.com": "X",
  "twitter.com": "X",
  "instagram.com": "Instagram",
  "facebook.com": "Facebook",
  "youtube.com": "YouTube",
  "tiktok.com": "TikTok",
  "line.me": "LINE",
  "note.com": "note",
  "github.com": "GitHub",
  "linkedin.com": "LinkedIn",
};
const labelFor = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, "");
  return LABELS[host] ?? host;
};
const profiles = [
  ...new Set([
    ...(site.sameAs ?? []),
    ...(Object.values(author.socials ?? {}).filter(Boolean) as string[]),
  ]),
];

// One list, one rendering: policy pages, mail, then external profiles.
const links: { label: string; href: string; external?: boolean }[] = [
  ...(site.footerNav ?? []),
  ...(author.email
    ? [{ label: "メール", href: `mailto:${author.email}` }]
    : []),
  ...profiles.map((url) => ({
    label: labelFor(url),
    href: url,
    external: true,
  })),
];

const linkClass =
  "tap-target text-muted no-underline transition-colors duration-300 hover:text-link";
---

<footer class="border-t border-border bg-bg">
  <div
    class="container-page grid gap-10 py-12 text-sm md:grid-cols-[1.4fr_1fr_1fr] md:gap-14 md:py-14"
  >
    <div>
      <a class="tap-target gap-3 text-fg no-underline" href="/">
        <img src="/favicon.svg" alt="" width="40" height="40" class="size-10" />
        <span class="font-heading text-xl font-medium tracking-[0.08em]"
          >{site.name}</span
        >
      </a>
      <p class="mt-4 mb-0 text-muted">{site.tagline}</p>
    </div>

    <nav
      aria-label="フッターナビゲーション"
      class="md:border-l md:border-border md:pl-10"
    >
      <ul class="m-0 flex list-none flex-col gap-1 p-0">
        {
          site.nav.map((item) => (
            <li>
              <a class={linkClass} href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul
      class="m-0 flex list-none flex-col gap-1 p-0 md:border-l md:border-border md:pl-10"
    >
      {
        links.map((link) => (
          <li>
            <a
              class={linkClass}
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <p
    class="m-0 bg-accent px-4 py-2.5 text-center text-xs tracking-[0.1em] text-on-accent"
  >
    {/* The rights holder is the business, not the person running the site. */}
    {`© ${year} ${site.business?.legalName ?? site.name}`}
  </p>
</footer>
