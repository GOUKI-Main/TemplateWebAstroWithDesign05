---
// Thin line arrow used by Button and TextLink. Drawn with currentColor so it
// follows the text color in both themes; nudges right on hover of the
// nearest `group`.
const { class: className } = Astro.props as { class?: string };
---

<svg
  class:list={[
    "h-2.5 w-6 shrink-0 transition-transform duration-300 ease-out group-hover:translate-x-1",
    className,
  ]}
  viewBox="0 0 24 10"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  aria-hidden="true"
>
  <path d="M0 5h22M17 1l5 4-5 4"></path>
</svg>
